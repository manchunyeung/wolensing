    "plt.semilogx(geofs, np.abs(geoFws)/fac,label=r'$F_{geo}$')\n",
    "# plt.semilogx(ws, np.abs(Fws)/fac,label=r'$F_{geo}$')\n",
    "plt.semilogx(conv_y, conv/fac,label=r'$F_{wave}$')\n",
    "plt.ylabel(r'$|F|/\\sqrt{\\mu}$')\n",
    "plt.xlabel(r'$f$')\n",
    "plt.grid(which='both', alpha=0.5)\n",
